# ============================================================================
#  Markdown PPT  .gitignore
# ----------------------------------------------------------------------------
#  原则：只上传「工具」（脚本 / 主题 / 模板），
#        不上传「你的内容」（decks/ 里通常有姓名、学号、班级和私人课件）。
#
#  改完记得自检（30 秒）：
#     git status --short            准备提交哪些文件
#     git ls-files                  真正被跟踪的文件（最终以它为准）
#     git check-ignore -v decks     是哪条规则挡住的
# ============================================================================


# ────────────────────────────────────────────────────────────────────────────
#  1. 你的个人内容 —— 默认全部不上传
# ────────────────────────────────────────────────────────────────────────────

# 每套演示放在 decks/<名字>/ 下，里面通常有主讲人姓名 / 学号 / 班级
decks/*
!decks/.gitkeep

# 私人素材（课件原件、导出稿等）
*.pptx
*.key

# 若某一套是公开的、想一起分享，取消注释下面两行并改成你的文件夹名。
# 放行前请务必确认该套 deck.md 里没有个人信息！
# !decks/2026-10-09-社交媒体禁令/
# !decks/2026-10-09-社交媒体禁令/**


# ────────────────────────────────────────────────────────────────────────────
#  2. 依赖与构建产物 —— 体积大，且都能重新生成
# ────────────────────────────────────────────────────────────────────────────

node_modules/
dist/
.marp/


# ────────────────────────────────────────────────────────────────────────────
#  3. 日志与临时文件
# ────────────────────────────────────────────────────────────────────────────

*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
~$*.pptx
~$*.docx
~$*.xlsx


# ────────────────────────────────────────────────────────────────────────────
#  4. 操作系统与编辑器
# ────────────────────────────────────────────────────────────────────────────

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
*~
.Trash-*

# 编辑器
*.swp
*.swo
.idea/
*.code-workspace
